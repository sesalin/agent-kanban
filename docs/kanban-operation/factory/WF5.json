      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const p=$input.first().json;if (!['FINAL_REVIEW','DONE'].includes(p.stage)) throw new Error('Faltan ramas por completar'); return [{json:p}];"
      }
    },
    {
      "id": "5f83d3cf-0003-4e46-b53d-ccf4f8059844",
      "name": "Comprobar resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const p=$input.first().json; if (!p.event_id || !(p.bytes>0 || p.specs_ready || p.file_ready || p.release_ready)) throw new Error('Falló la operación de archivos.');\nreturn [{json:p}];"
      }
    },
    {
      "id": "aecf5a1d-1087-430f-a9e0-1852d259c014",
