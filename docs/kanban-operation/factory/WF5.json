      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const p = $input.first().json.body ?? $input.first().json;\nif (typeof p.event_id !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(p.event_id)) throw new Error('event_id inválido');\nif (typeof p.executive_summary!=='string' || !p.executive_summary.trim() || p.bundle_path!=='/mnt/c/_mcp/muse-packages/'+p.event_id+'/') throw new Error('Cierre inválido');\nreturn [{json:p}];"
      }
    },
    {
      "id": "e72685fb-567b-4587-af09-4e2c90b8d971",
      "name": "Consultar pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://uobeshcvmtawjxibciuy.supabase.co/rest/v1/rpc/factory_get",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({p_event_id:$('Validar entrada').first().json.event_id}) }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "6tc6sprc6stOuXbn",
          "name": "RADARS_SUPABASE"
        }
      }
    },
    {
