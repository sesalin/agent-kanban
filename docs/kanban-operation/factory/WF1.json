        }
      }
    },
    {
      "id": "5ec89754-9dbe-43dc-8436-0b48c8a710db",
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const p = $input.first().json.body ?? $input.first().json;\nif (typeof p.event_id !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(p.event_id)) throw new Error('event_id inválido');\nif (!['radar_gobierno_nl','radar_compras_publicas','radar_regulacion_federal'].includes(p.radar_table) || !p.title || !p.package_path || !p.package_filename) throw new Error('Faltan datos del paquete');\nreturn [{json:p}];"
      }
    },
    {
      "id": "e3352f66-a6db-4d5c-93d6-88b46c5d624c",
      "name": "Comprobar paquete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const p=$input.first().json; if (!p.event_id || !(p.bytes>0 || p.specs_ready || p.file_ready || p.release_ready)) throw new Error('Falló la operación de archivos.');\nreturn [{json:p}];"
      }
    },
    {
      "id": "1f8cb07a-4bc4-4e2b-991d-ddd70f22a0f2",
      "name": "Registrar pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://uobeshcvmtawjxibciuy.supabase.co/rest/v1/rpc/factory_start",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({p_payload:$('Validar entrada').first().json}) }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "6tc6sprc6stOuXbn",
          "name": "RADARS_SUPABASE"
        }
      }
    },
    {
      "id": "d126204d-5c9f-4717-a57b-17f310d2767a",
      "name": "Preparar tarjeta Brio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const p=$input.first().json;\nif (p.stage !== 'RESEARCH') return [];\nreturn [{json:{project_id:1,title:'Investigar: '+p.title,description:'Investiga el paquete y entrega research.zip. Después de entregar, consulta la siguiente tarjeta asignada a brio.',assigned_to:'brio',metadata:{event_id:p.event_id,factory_dispatch_key:p.event_id+':research',muse_zip:{path:p.base_folder+'/01_input',input_file:'paquete.zip',output_path:p.base_folder+'/02_research',output_file:'research.zip'}}}}];"
      }
    },
