        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://kanban-api.okehc.com/api/tasks/' + $('Validar entrada').first().json.task_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
