    },
    {
      "id": "be61f60a-cc44-4d7e-8dee-914d0cdd9784",
      "name": "Validar entrega de rama",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const t=$input.first().json,p=$('Validar entrada').first().json,f=$('Consultar pipeline').first().json;\nconst defs={mvp:['codex','04_mvp/mvp.zip'],prospection:['nod','05_prospects/prospects.zip'],landing:['nod','06_landing/landing.zip']};\nconst [agent,path]=defs[p.branch];\nif (!f['run_'+p.branch] || String(f[p.branch+'_task_id'])!==String(p.task_id) || t.id!==p.task_id || t.project_id!==1 || t.claimed_by!==agent || !['review','done'].includes(t.status) || t.metadata_payload?.event_id!==p.event_id || p.zip_path!==p.event_id+'/'+path || !['BUILDING','FINAL_REVIEW'].includes(f.stage)) throw new Error('Entrega no corresponde a una rama activa');\nreturn [{json:t}];"
      }
    },
    {
      "id": "91989e37-4172-4230-882b-36fdd2f71c97",
      "name": "Comprobar ZIP de rama",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "const p=$input.first().json; if (!p.event_id || !(p.bytes>0 || p.specs_ready || p.file_ready || p.release_ready)) throw new Error('Falló la operación de archivos.');\nreturn [{json:p}];"
      }
    },
    {
      "id": "3ab5dcaf-9e8d-4692-bfa7-20627283927d",
      "name": "¿Requiere aprobación?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        1680,
        0
      ],
      "parameters": {
