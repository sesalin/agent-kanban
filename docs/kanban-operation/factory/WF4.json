    {
      "id": "9ea67f4e-0738-4468-89d1-340cfec4aee9",
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const p = $input.first().json.body ?? $input.first().json;\nif (typeof p.event_id !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(p.event_id)) throw new Error('event_id inválido');\np.task_id=Number(p.task_id); if (!Number.isSafeInteger(p.task_id) || p.task_id<1 || !['mvp','prospection','landing'].includes(p.branch)) throw new Error('Rama inválida');\nreturn [{json:p}];"
      }
    },
    {
      "id": "64d5ac2b-27f9-40f5-93e8-1e4410f0abcb",
      "name": "Consultar pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://uobeshcvmtawjxibciuy.supabase.co/rest/v1/rpc/factory_get",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({p_event_id:$('Validar entrada').first().json.event_id}) }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "6tc6sprc6stOuXbn",
          "name": "RADARS_SUPABASE"
        }
