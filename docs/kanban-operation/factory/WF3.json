    {
      "id": "6919ac40-13e1-49a6-b4bd-f92a1a6591f7",
      "name": "Validar investigación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const t=$input.first().json,p=$('Validar entrada').first().json,f=$('Consultar pipeline').first().json;\nif (String(t.id)!==String(f.brio_task_id) || t.id!==p.task_id || t.project_id!==1 || t.claimed_by!=='brio' || !['review','done'].includes(t.status) || t.metadata_payload?.event_id!==p.event_id || !['EVALUATING','BUILDING','REJECTED'].includes(f.stage)) throw new Error('Investigación o pipeline incorrectos');\nreturn [{json:t}];"
      }
    },
