    {
      "id": "91c708cc-7c6f-4f0f-b765-5346cc6ace42",
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const p = $input.first().json.body ?? $input.first().json;\nif (typeof p.event_id !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(p.event_id)) throw new Error('event_id inválido');\np.task_id=Number(p.brio_task_id);\nif (!Number.isSafeInteger(p.task_id) || p.task_id<1 || !['GO','NO_GO'].includes(p.decision)) throw new Error('Decisión inválida');\nfor (const b of ['mvp','prospection','landing']) {\n if (typeof p.branches?.['run_'+b]!=='boolean') throw new Error('Las banderas deben ser booleanas');\n if (p.decision==='NO_GO' && p.branches['run_'+b]) throw new Error('NO_GO no activa ramas');\n const key=b==='prospection'?'icp_prompt':b+'_prompt';\n if (p.branches['run_'+b] && !p.specs?.[key]?.trim()) throw new Error('Falta el prompt de una rama activa');\n}\nif (p.decision==='GO' && !Object.values(p.branches).some(v=>v===true)) throw new Error('GO necesita una rama activa');\nreturn [{json:p}];"
      }
    },
    {
