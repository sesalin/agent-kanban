      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        0
      ],
      "parameters": {
        "jsCode": "const p=$('Validar entrada').first().json;\nconst defs=[['mvp','codex','04_mvp','mvp.zip','mvp_prompt'],['prospection','nod','05_prospects','prospects.zip','icp_prompt'],['landing','nod','06_landing','landing.zip','landing_prompt']];\nreturn defs.filter(([b])=>p.branches['run_'+b]).map(([branch,agent,folder,output,prompt])=>({json:{event_id:p.event_id,branch,agent,card:{project_id:1,title:branch+': '+p.event_id,description:p.specs[prompt],assigned_to:agent,metadata:{event_id:p.event_id,branch,factory_dispatch_key:p.event_id+':'+branch,muse_zip:{path:p.event_id+'/03_specs',input_file:branch+'-input.zip',output_path:p.event_id+'/'+folder,output_file:output}}}},pairedItem:{item:0}}));"
      }
