      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const t=$input.first().json,p=$('Validar entrada').first().json,f=$('Consultar pipeline').first().json;\nif (String(t.id)!==String(f.brio_task_id) || t.id!==p.task_id || t.project_id!==1 || t.claimed_by!=='brio' || t.status!=='review' || t.metadata_payload?.event_id!==p.event_id) throw new Error('La tarjeta no corresponde a la entrega en revisión');\nreturn [{json:p}];"
      }
    },
