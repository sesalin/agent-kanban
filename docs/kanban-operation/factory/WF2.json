      "parameters": {
        "jsCode": "const p = $input.first().json.body ?? $input.first().json;\nif (typeof p.event_id !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(p.event_id)) throw new Error('event_id inválido');\np.task_id=Number(p.brio_task_id); if (!Number.isSafeInteger(p.task_id) || p.task_id<1 || p.research_zip_path!==p.event_id+'/02_research/research.zip') throw new Error('Entrega inválida');\nreturn [{json:p}];"
      }
