      "typeVersion": 4.2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://kanban-api.okehc.com/api/factory/reports/' + $('Leer informe pendiente').item.json.report_date + '/sent' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({message_id:Number($json.result?.message_id ?? $json.message_id)}) }}",
        "options": {
          "timeout": 240000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpBearerAuth": {
          "id": "MhO6jMfbdNT6QcOg",
